sólo para Sucursal. Parte puede comprar y vender: no hay especialización Cliente/Proveedor. Identificacion modela el código como entidad con historia (no atributo multivaluado). La sede operadora del animal es inmutable (RN-004)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;shape=note;size=12;fillColor=#f5f5f5;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="1080" width="620" height="100" as="geometry"/></mxCell><mxCell id="t_76" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1540" y="1000" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_77" value="Entidad fuerte" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="1026" width="100" height="30" as="geometry"/></mxCell><mxCell id="lg_78" value="Entidad débil" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;shape=ext;double=1;margin=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="1026" width="100" height="30" as="geometry"/></mxCell><mxCell id="lg_79" value="relación" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;shape=rhombus;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="1066" width="100" height="44" as="geometry"/></mxCell><mxCell id="lgr_80" value="identif." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;shape=rhombus;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="1066" width="110" height="44" as="geometry"/></mxCell><mxCell id="lgr_80_in_81" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#000000;strokeWidth=1.2;sh