0" y="370" /><mxPoint x="2010" y="240" /></Array></mxGeometry></mxCell><mxCell id="ley" value="&lt;b&gt;Leyenda (notación pata de gallo / IE)&lt;/b&gt;&lt;br&gt;PK clave primaria (subrayada) · FK clave foránea · UK participa en clave única · NN NOT NULL · GEN columna generada&lt;br&gt;Extremo padre: ‖ exactamente uno (FK NOT NULL) · o| cero o uno (FK opcional). Extremo hijo: o&lt; cero o muchos · o| cero o uno (FK única)&lt;br&gt;Línea continua: relación identificante (la FK forma parte de la PK) · discontinua: no identificante&lt;br&gt;Triángulo central: dirección FK → clave referenciada; los símbolos de los extremos indican cardinalidad.&lt;br&gt;Todas las FK locales incluyen (empresa_id, sucursal_id); las FK a maestros incluyen empresa_id. Cada conector une la columna FK con la columna referenciada.&lt;br&gt;Restricciones no gráficas (CHECK, UNIQUE parciales, EXCLUDE, triggers): docs/database/data-dictionary.md y administration.md" style="text;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;strokeColor=#334155;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="60" y="2630" width="1500" height="140" as="geometry" /></mxCell><mxCell id="fk_0_direccion" value="" vertex="1" parent="1" connectable="0" style="shape=triangle;direction=east;rotation=-90.0;fillColor=#475569;strokeColor=none;"><mxGeometry x="33.0" y="305.0" width="14" height="10" as="geometry" /></mxCell><mxCell id="fk_1_direccion" value="" vertex="1" parent="1" connectable="0" style="shape=triangle;direction=east;rotation=-90.0;fillColor=#475569;strokeColor=none;"><mxGeometry x="543.0" y="495.0" width="14" height="10" as="geometry" /></mxCell><mxCell id="fk_2_direccion" value="" vertex="1" parent="1" connectable="0" style="shape=triangle;direction=east;rotation=-90.0;fillColor=#475569;strokeColor=none;"><mxGeometry x="33.0" y="755.0" width="14" height="10" as="geometry" /></mxCell><mxCell id="fk_3_direccion" value="" vertex="1" parent="1" connectable="0" style="shape=triangle;direction=eas