# Variables orientativas; exportarlas para make o usar --env-file con Compose.
# Secretos reales son archivos externos0700/0600, nunca valores en este archivo.
BOVI_SECRET_DIR=/ruta/privada/bovicierre/secrets
BOVI_PRIVATE_DIR=/ruta/privada/bovicierre
BOVI_UID=1000
BOVI_GID=1000
BOVI_ENV=academic
# Despliegue futuro: profileproduction exige cookieSecure; no ejecutado aquí.
SPRING_PROFILES_ACTIVE=local
BOVI_DOMAIN=bovicierre.example.invalid
TLS_CONTACT_EMAIL=administracion@example.invalid
