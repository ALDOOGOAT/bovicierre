# Railway: TLS lo termina el borde de Railway; upstreams por la red privada (*.railway.internal) vía variables.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}
:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}
	# JSON de la API: 1 MB; cargas multipart de documentos conservan el límite de Spring (20 MB) con margen.
	@apijson {
		path /api/*
		header Content-Type application/json*
	}
	@apiupload {
		path /api/*
		not header Content-Type application/json*
	}
	request_body @apijson {
		max_size 1MB
	}
	request_body @apiupload {
		max_size 22MB
	}
	handle /api/* {
		reverse_proxy {$BOVI_API_UPSTREAM} {
			header_up X-Real-IP {client_ip}
		}
	}
	handle {
		encode gzip
		reverse_proxy {$BOVI_WEB_UPSTREAM}
	}
}
